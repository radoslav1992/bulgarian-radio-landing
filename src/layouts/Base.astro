---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path-relative or absolute image URL for Open Graph + Twitter. */
  ogImage?: string;
  /** Canonical path (defaults to current pathname). Useful to dedupe with/without trailing slash. */
  canonicalPath?: string;
  /** Page type for OpenGraph (default 'website'). */
  ogType?: 'website' | 'article';
  /** Optional JSON-LD structured-data object(s) to inject into <head>. */
  jsonLd?: object | object[];
  /** ISO date string for article:published_time (blog posts). */
  publishedTime?: string;
  /** Author name for article:author (blog posts). */
  articleAuthor?: string;
  /** Set true to add noindex (e.g. user-specific pages). */
  noindex?: boolean;
  /** OG article tags for blog posts. */
  articleTags?: string[];
}

const SITE_URL = 'https://bulgariaradio.com';
const SITE_NAME = 'Радио България';
const DEFAULT_DESC = 'Слушай безплатно над 100 български радио станции онлайн — поп, рок, фолк, дип хаус и още. Директно в браузъра, без регистрация.';

const {
  title,
  description = DEFAULT_DESC,
  ogImage = '/logo.png',
  canonicalPath,
  ogType = 'website',
  jsonLd,
  publishedTime,
  articleAuthor,
  noindex = false,
  articleTags = [],
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href);

const canonical = new URL(canonicalPath ?? path, SITE_URL).toString();
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_URL).toString();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  email: 'info@bulgariaradio.com',
  description: DEFAULT_DESC,
  areaServed: { '@type': 'Country', name: 'България' },
};
const jsonLdArr = [orgJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#ece5d8" />
    {/* Apply the saved/system theme before first paint to avoid a flash. */}
    <script is:inline data-astro-rerun>
      (() => {
        let theme = 'light';
        try {
          const stored = localStorage.getItem('br-theme');
          theme = stored === 'dark' || stored === 'light'
            ? stored
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch {}
        document.documentElement.dataset.theme = theme;
        const m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', theme === 'dark' ? '#1d1812' : '#ece5d8');
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="BG" />
    <meta name="geo.placename" content="България" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="bg" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={`${SITE_NAME} — лого`} />
    <meta property="og:locale" content="bg_BG" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {jsonLdArr.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    {/*
      AdSense — uncomment after approval and replace ca-pub-XXXXXXXXXXXXXXXX
      with your real publisher ID. The slots in the page templates will start
      filling automatically.

      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    */}

    <!-- Google tag (gtag.js) — page_view is sent per navigation (see site script) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TT4LN8D2B8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TT4LN8D2B8', { send_page_view: false });
    </script>

    <ViewTransitions />
  </head>
  <body>
    <a href="#main" class="skip-link">Към основното съдържание</a>

    <div class="flag-bar"><div class="w"></div><div class="g"></div><div class="r"></div></div>

    <header class="site">
      <div class="container row">
        <a class="brand" href="/">
          <img src="/logo.png" alt="" width="40" height="40" />
          <span class="brand-name">Радио България</span>
        </a>
        <nav class="site" id="main-nav" aria-label="Основна навигация">
          <a href="/" class:list={{ active: isActive('/') }}>Слушай</a>
          <a href="/favorites" class:list={{ active: isActive('/favorites') }}>Любими</a>
          <a href="/history" class:list={{ active: isActive('/history') }}>История</a>
          <a href="/stations" class:list={{ active: path.startsWith('/stations') }}>Станции</a>
          <a href="/blog" class:list={{ active: path.startsWith('/blog') }}>Блог</a>
          <a href="/about" class:list={{ active: isActive('/about') }}>За нас</a>
          <a href="/contact" class:list={{ active: isActive('/contact') }}>Контакт</a>
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Смени светла/тъмна тема">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
            </svg>
          </button>
          <button class="nav-toggle" type="button" aria-label="Меню" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="container footer-grid">
        <div class="footer-col footer-brand">
          <div class="brand">
            <img src="/logo.png" alt="" width="36" height="36" />
            <span>Радио България</span>
          </div>
          <p>Безплатен достъп до български радио станции — директно в браузъра. Android приложение очаквайте скоро.</p>
        </div>
        <div class="footer-col">
          <h4>Приложение</h4>
          <a href="/">Слушай онлайн</a>
          <a href="/favorites">Любими</a>
          <a href="/history">История</a>
        </div>
        <div class="footer-col">
          <h4>Информация</h4>
          <a href="/stations">Станции</a>
          <a href="/blog">Блог</a>
          <a href="/about">За нас</a>
          <a href="/contact">Контакт</a>
          <a href="/sitemap-index.xml">Карта на сайта</a>
        </div>
        <div class="footer-col">
          <h4>Правни</h4>
          <a href="/privacy-policy">Поверителност</a>
          <a href="/terms">Условия</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Радио България. Всички права запазени.</span>
        <span class="footer-credit">Станциите се предоставят от <a href="https://www.radio-browser.info" target="_blank" rel="noopener noreferrer">Radio Browser</a>.</span>
      </div>
    </footer>

    <div class="flag-bar bottom"><div class="w"></div><div class="g"></div><div class="r"></div></div>

    <!-- Cookie consent banner -->
    <div class="consent" data-consent hidden>
      <div class="consent-inner container">
        <div class="consent-text">
          <strong>Този сайт използва бисквитки</strong>
          <p>
            Използваме само технически необходими бисквитки, за да запомним избора ви
            (плейър, любими, изглед). Повече в
            <a href="/privacy-policy">Политиката за поверителност</a>.
          </p>
        </div>
        <div class="consent-actions">
          <button type="button" class="cta-secondary" data-consent-reject>Само необходимите</button>
          <button type="button" class="cta" data-consent-accept>Приемам</button>
        </div>
      </div>
    </div>

    <!-- Back to top -->
    <button class="back-to-top" type="button" data-back-to-top aria-label="Обратно в началото">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>

    <!-- Persistent player dock: mini bar + modal survive soft navigations -->
    <div class="now-playing" data-now-playing aria-live="polite" transition:persist="now-playing">
      <div class="np-info">
        <div class="np-logo" data-np-logo></div>
        <div class="np-text">
          <div class="np-name" data-np-name></div>
          <div class="np-song" data-np-song></div>
          <div class="np-state" data-np-state></div>
          <div class="np-sleep" data-np-sleep hidden></div>
        </div>
      </div>
      <button class="np-btn np-secondary" data-np-prev type="button" aria-label="Предишна станция">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zM9.5 12l8.5 6V6z"/></svg>
      </button>
      <button class="np-btn np-primary" data-np-toggle type="button" aria-label="Пусни">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button class="np-btn np-secondary" data-np-next type="button" aria-label="Следваща станция">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z"/></svg>
      </button>
      <button class="np-btn np-expand" data-np-expand type="button" aria-label="Отвори плейъра">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 14v6h6M20 10V4h-6M4 20l7-7M20 4l-7 7"/>
        </svg>
      </button>
    </div>

    <div class="player-modal" data-modal role="dialog" aria-modal="true" aria-label="Плейър" transition:persist="player-modal">
      <div class="modal-radio">
        <header class="modal-head">
          <button class="modal-icon-btn" data-modal-close type="button" aria-label="Затвори">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          <div class="modal-title">
            <span class="brand-dot">❀</span>
            РАДИО БЪЛГАРИЯ
          </div>
          <button class="modal-icon-btn fav-modal" data-modal-fav type="button" aria-label="Добави в любими" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.3l-5.4 3.2 1.4-6.1L3 10.4l6.2-.5L12 4l2.8 5.9 6.2.5-5 4 1.4 6.1z"/></svg>
          </button>
        </header>

        <div class="grill"></div>

        <div class="modal-logo-wrap">
          <div class="modal-logo" data-modal-logo></div>
        </div>

        <div class="dial">
          <div class="dial-ticks" aria-hidden="true"></div>
          <div class="dial-needle" aria-hidden="true"></div>
          <div class="dial-name" data-modal-name></div>
          <div class="dial-song" data-modal-song></div>
          <div class="dial-lang" data-modal-lang></div>
        </div>

        <div class="modal-state" data-modal-state></div>

        <div class="vu-frame">
          <div class="vu" data-modal-vu>
            <span style="--h:30%"></span>
            <span style="--h:55%"></span>
            <span style="--h:40%"></span>
            <span style="--h:75%"></span>
            <span style="--h:60%"></span>
            <span style="--h:85%"></span>
            <span style="--h:50%"></span>
            <span style="--h:70%"></span>
            <span style="--h:35%"></span>
          </div>
        </div>

        <div class="tag-chips" data-modal-tags></div>

        <div class="vote-row">
          <button class="vote-btn" data-modal-vote type="button" aria-label="Гласувай за тази станция">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
            <span data-vote-label>Гласувай</span>
          </button>
          <span class="vote-count" data-vote-count></span>
          <button class="vote-btn" data-modal-share type="button" aria-label="Сподели">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span data-share-label>Сподели</span>
          </button>
        </div>

        <div class="modal-controls">
          <button class="modal-step-btn" data-modal-prev type="button" aria-label="Предишна станция">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zM9.5 12l8.5 6V6z"/></svg>
          </button>
          <button class="big-btn" data-modal-toggle type="button" aria-label="Пусни">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <button class="modal-step-btn" data-modal-next type="button" aria-label="Следваща станция">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z"/></svg>
          </button>
        </div>

        <div class="volume-row">
          <svg viewBox="0 0 24 24" fill="currentColor" class="vol-icon">
            <path d="M3 10v4h4l5 4V6L7 10H3z"/>
          </svg>
          <input
            type="range"
            min="0"
            max="1"
            step="0.01"
            data-modal-volume
            aria-label="Сила на звука"
          />
          <svg viewBox="0 0 24 24" fill="currentColor" class="vol-icon">
            <path d="M3 10v4h4l5 4V6L7 10H3zm11.5 2c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
          </svg>
        </div>

        <div class="sleep-row">
          <button class="sleep-btn" data-sleep-toggle type="button" aria-label="Таймер за сън">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span data-sleep-label>Таймер</span>
          </button>
          <div class="sleep-options" data-sleep-options hidden>
            <button type="button" data-sleep-min="15">15 мин</button>
            <button type="button" data-sleep-min="30">30 мин</button>
            <button type="button" data-sleep-min="60">60 мин</button>
            <button type="button" data-sleep-min="90">90 мин</button>
            <button type="button" data-sleep-min="0">Изкл.</button>
          </div>
        </div>
      </div>
    </div>

    <script>
      import '../scripts/player.ts';
    </script>

    <script>
      // Site-wide UI glue. This module runs once per session; per-page work
      // hangs off astro:page-load (fires on first load and every navigation).
      const THEME_KEY = 'br-theme';
      const CONSENT_KEY = 'br-consent-v1';

      function currentTheme(): 'light' | 'dark' {
        return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      }

      function applyTheme(theme: 'light' | 'dark') {
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#1d1812' : '#ece5d8');
      }

      // PWA install: when the browser offers installability, turn the
      // "Android — очаквайте скоро" placeholders into real install buttons.
      let installPrompt: any = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        installPrompt = e;
        decorateInstallCtas();
      });
      window.addEventListener('appinstalled', () => {
        installPrompt = null;
        document.querySelectorAll<HTMLElement>('[data-install]').forEach((el) => {
          el.textContent = 'Приложението е инсталирано ✓';
          el.removeAttribute('data-install');
        });
      });
      function decorateInstallCtas() {
        if (!installPrompt) return;
        document.querySelectorAll<HTMLElement>('.cta-coming-soon').forEach((el) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cta';
          btn.setAttribute('data-install', '');
          btn.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"/></svg>'
            + 'Инсталирай приложението';
          el.replaceWith(btn);
        });
      }

      // Delegated clicks survive view-transition DOM swaps.
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;

        const consentBtn = t.closest('[data-consent-accept], [data-consent-reject]');
        if (consentBtn) {
          try {
            localStorage.setItem(CONSENT_KEY, consentBtn.hasAttribute('data-consent-accept') ? 'accept' : 'reject');
          } catch {}
          const banner = document.querySelector<HTMLElement>('[data-consent]');
          if (banner) banner.hidden = true;
          return;
        }

        const navBtn = t.closest<HTMLButtonElement>('.nav-toggle');
        const nav = document.querySelector<HTMLElement>('#main-nav');
        if (navBtn && nav) {
          const open = nav.classList.toggle('open');
          navBtn.setAttribute('aria-expanded', String(open));
          return;
        }
        if (nav && t.closest('#main-nav a')) {
          nav.classList.remove('open');
          document.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
        }

        if (t.closest('[data-theme-toggle]')) {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem(THEME_KEY, next); } catch {}
          applyTheme(next);
          return;
        }

        if (t.closest('[data-back-to-top]')) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        if (t.closest('[data-install]') && installPrompt) {
          installPrompt.prompt();
        }
      });

      // Back-to-top visibility
      const syncBackToTop = () => {
        document.querySelector('[data-back-to-top]')
          ?.classList.toggle('visible', window.scrollY > 600);
      };
      window.addEventListener('scroll', syncBackToTop, { passive: true });

      // The router swaps in the new document's <html> attributes — re-apply
      // the chosen theme before the new page paints.
      document.addEventListener('astro:after-swap', () => {
        let theme: 'light' | 'dark' = 'light';
        try {
          const stored = localStorage.getItem(THEME_KEY);
          theme = stored === 'dark' || stored === 'light'
            ? stored
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch {}
        applyTheme(theme);
      });

      document.addEventListener('astro:page-load', () => {
        // Cookie consent (banner markup is fresh after each swap)
        const banner = document.querySelector<HTMLElement>('[data-consent]');
        if (banner && !localStorage.getItem(CONSENT_KEY)) banner.hidden = false;

        decorateInstallCtas();
        syncBackToTop();

        // GA4 page view per (soft or hard) navigation
        (window as any).gtag?.('event', 'page_view', {
          page_location: window.location.href,
          page_title: document.title,
        });
      });

      // Register service worker for PWA
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
