---
// Page-specific station list. The mini bar, modal, and audio element live in
// the Base layout (persistent across navigations); this component only
// renders the browse/favorites/history list section.
interface Props {
  /**
   * 'browse'    — fetch all BG stations from Radio Browser API (landing page).
   * 'favorites' — render saved favorites from localStorage.
   * 'history'   — render listen history from localStorage.
   */
  mode?: 'browse' | 'favorites' | 'history';
  /** Whether to show the search input. Defaults to true for browse, false otherwise. */
  showSearch?: boolean;
}
const { mode = 'browse', showSearch = mode === 'browse' } = Astro.props;
---
<div class="player" data-player data-mode={mode}>
  <div class="player-toolbar" style="display:none;">
    {showSearch && (
      <div class="player-search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="search" data-search placeholder="Търси станции..." autocomplete="off" />
        <button class="search-clear" type="button" data-search-clear aria-label="Изчисти търсенето" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    )}
    <span class="count" data-count></span>
    <div class="view-toggle" role="tablist" aria-label="Вид на списъка">
      <button class="vt-btn" data-view="list" type="button" role="tab" aria-label="Списък">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <button class="vt-btn" data-view="grid" type="button" role="tab" aria-label="Решетка">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/>
          <rect x="14" y="3" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/>
        </svg>
      </button>
    </div>
  </div>

  {mode === 'browse' && <div class="genre-filters" data-genres style="display:none;"></div>}
  {mode === 'browse' && <div class="genre-filters" data-cities style="display:none;"></div>}

  <div class="player-loading" data-status>
    {mode === 'browse' ? (
      <>
        <div class="skeleton" aria-hidden="true">
          <div class="sk-pills">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
          {Array.from({ length: 8 }).map(() => <div class="sk-row"></div>)}
        </div>
        <p class="sr-only">Зареждане на станции…</p>
      </>
    ) : (
      <p></p>
    )}
  </div>

  <div class="stations" data-stations></div>
  <div class="sentinel" data-sentinel aria-hidden="true">
    <div class="spinner small"></div>
  </div>
</div>
