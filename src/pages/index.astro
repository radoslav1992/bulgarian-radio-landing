---
import Base from '../layouts/Base.astro';
import Feature from '../components/Feature.astro';
import RadioPlayer from '../components/RadioPlayer.astro';
import LogoMark from '../components/LogoMark.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const SITE_URL = 'https://bulgariaradio.com';
/** Site launch (first deploy) — used as datePublished everywhere on this page. */
const DATE_PUBLISHED = '2026-05-26';
/** Bump on meaningful landing-page content changes. */
const DATE_MODIFIED = '2026-08-04';
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('bg-BG', { year: 'numeric', month: 'long', day: 'numeric' });

// "Станции на фокус" carousel: the directory profiles, each with a tinted
// crop of the hero artwork as its cover.
const COVER_HUES = [0, 38, -34, 62, -18, 24, -52, 48];
const spotlight = (await getCollection('stations'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'bg'))
  .map((st, i) => {
    const m = st.data.frequencies[0]?.match(/^(.*?)\s*(\d{2,3}[.,]\d)\s*(FM|MHz)?/i);
    return {
      slug: st.slug,
      name: st.data.name,
      format: st.data.format,
      playQuery: st.data.playerQuery ?? st.data.name,
      freq: m ? { city: m[1], num: m[2].replace(',', '.'), unit: m[3] ?? 'FM' } : null,
      coverStyle: `--hue:${COVER_HUES[i % COVER_HUES.length]}deg;--pos:${(i * 29) % 100}% ${(i * 47) % 100}%`,
    };
  });

const features = [
  {
    title: 'Стотици станции',
    description: 'Над 100 български радио станции на едно място — поп, рок, фолк, дип хаус, новини, спорт и още.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11h16M4 16h16M9 7l3-3 3 3"/><circle cx="8" cy="16" r="1.5" fill="currentColor"/></svg>',
  },
  {
    title: 'Любими станции',
    description: 'Запази любимите си с един клик и им се радвай в собствен раздел. Бърз достъп до това, което слушаш най-често.',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.3l-5.4 3.2 1.4-6.1L3 10.4l6.2-.5L12 4l2.8 5.9 6.2.5-5 4 1.4 6.1z"/></svg>',
  },
  {
    title: 'История на слушане',
    description: 'Виж последно слушаните станции и се върни към тях с едно докосване. Никога не губи интересна станция.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  },
  {
    title: 'Безплатно и просто',
    description: 'Без регистрация, без абонамент, без скрити такси. Отвори, избери станция, слушай.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7"/></svg>',
  },
  {
    title: 'Работи в фон',
    description: 'Продължава да свири, докато ползваш други приложения или заключиш екрана. Управление от заключения екран.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="3" width="12" height="18" rx="2"/><circle cx="12" cy="17" r="1" fill="currentColor"/></svg>',
  },
  {
    title: 'Малко място',
    description: 'Приложението е лековато и не товари батерията. Без излишни разрешения.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/></svg>',
  },
];

const faqs = [
  {
    q: 'Безплатно ли е?',
    a: 'Да, напълно безплатно — и уеб плейърът, и бъдещото мобилно приложение. Няма абонамент, няма пробен период, няма скрити такси.',
  },
  {
    q: 'Откъде идват радио станциите?',
    a: 'Каталогът се захранва от Radio Browser — отворена, общностно поддържана база данни с радио станции от целия свят. Самите потоци се излъчват от съответните радиа.',
  },
  {
    q: 'Трябва ли да създавам акаунт?',
    a: 'Не. Просто отворете сайта и започнете да слушате. Любимите станции и историята се пазят локално в браузъра ви.',
  },
  {
    q: 'Колко мобилни данни ползва?',
    a: 'Типично 60–120 MB на час, в зависимост от качеството на потока (повечето български станции излъчват на 96–128 kbps). При свързване с Wi-Fi не се изразходват мобилни данни.',
  },
  {
    q: 'Защо някои станции не свирят?',
    a: 'Браузърът блокира потоци без HTTPS и без поддръжка на HLS. Затова в уеб версията виждате по-малък подсет от станциите. Бъдещото Android приложение ще поддържа всички формати.',
  },
  {
    q: 'Работи ли извън България?',
    a: 'Да, приложението работи навсякъде, където има интернет. Идеално за българи в чужбина, които искат да чуят родното радио.',
  },
  {
    q: 'Достъпно ли е за iOS / iPhone?',
    a: 'Мобилно приложение все още няма — работим първо по Android версията. Уеб версията на този сайт обаче работи във всеки модерен браузър, включително Safari на iOS.',
  },
  {
    q: 'Каква е разликата между FM радио и интернет радио?',
    a: 'FM радиото използва радиочестоти и приемник, а интернет радиото предава звука като цифров поток през интернет. Онлайн стрийминг означава по-широк избор от станции, метаданни за песните и достъп от всяка точка на света.',
  },
  {
    q: 'Мога ли да слушам радио без интернет?',
    a: 'За интернет радиото е необходима интернет връзка — мобилни данни или Wi-Fi. Ако искате да слушате офлайн, единствената алтернатива засега е класическо FM радио с физически приемник.',
  },
  {
    q: 'Как мога да добавя станция, която липсва?',
    a: 'Каталогът се захранва от Radio Browser — отворена общностна база данни. Можете да предложите нова станция директно на radio-browser.info или да ни пишете през страницата за контакт с URL на потока.',
  },
  {
    q: 'Безопасно ли е за деца?',
    a: 'Сайтът е предназначен за потребители на 13+ години. Самото съдържание на радиостанциите е на живо и не се контролира от нас — препоръчваме родителски контрол при по-малки деца.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Радио България',
    url: SITE_URL,
    browserRequirements: 'Requires a modern browser with HTML5 audio support',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'All',
    description: 'Безплатен уеб плейър за български радио станции онлайн. Android приложение — очаквайте скоро.',
    inLanguage: 'bg',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BGN' },
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    datePublished: DATE_PUBLISHED,
    dateModified: DATE_MODIFIED,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Радио България',
    url: SITE_URL,
    inLanguage: 'bg',
    publisher: { '@id': `${SITE_URL}/#organization` },
    copyrightHolder: { '@id': `${SITE_URL}/#organization` },
    datePublished: DATE_PUBLISHED,
    dateModified: DATE_MODIFIED,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://bulgariaradio.com/?q={search_term_string}#player',
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---
<Base
  title="Радио България — Български радио станции онлайн"
  description="Слушай безплатно над 100 български радио станции — поп, рок, фолк, дип хаус, новини. Директно в браузъра, без регистрация. Android приложение — очаквайте скоро."
  jsonLd={jsonLd}
  publishedTime={DATE_PUBLISHED}
  modifiedTime={DATE_MODIFIED}
>
  <section class="hero" data-hero>
    <img
      class="hero-bg"
      src="/art/hero-waves-1600.webp"
      srcset="/art/hero-waves-900.webp 900w, /art/hero-waves-1600.webp 1600w"
      sizes="100vw"
      alt=""
      width="1600"
      height="1000"
      fetchpriority="high"
    />
    <div class="container hero-inner">
      <button class="hero-play" type="button" data-hero-play aria-label="Пусни радио">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>
      </button>
      <h1>Слушай на живо с <span class="neon">Радио България</span></h1>
      <p class="tagline">
        Слушай безплатно над 100 български радио станции — поп, рок, фолк, дип хаус, новини и още.
        Директно в браузъра, без регистрация.
      </p>

      <div class="hero-feature">
        <div class="hf-cover" data-hero-logo><LogoMark size=64 /></div>
        <div class="hf-text">
          <p class="hf-status" data-hero-status>Най-слушани днес</p>
          <p class="hf-name" data-hero-name>100+ български станции</p>
          <p class="hf-meta" data-hero-meta>Поп, рок, фолк, джаз и новини</p>
          <a class="hf-link" href="#player">Пусни музиката</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-strip" aria-label="Кратки факти">
    <div class="container stats-inner">
      <ul class="trust-row">
        <li><strong>100+</strong> станции</li>
        <li><strong>0 лв</strong> безплатно</li>
        <li><strong>Без</strong> регистрация</li>
      </ul>
      <span class="cta cta-coming-soon" id="download">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5c0-.6.3-1.1.8-1.4L13.5 12 3.8 21.9c-.5-.3-.8-.8-.8-1.4zm10.6-8.5l2.5-2.5L5.5 3.4c-.3-.2-.6-.3-.9-.3l9 8.9zm6.5-3.7L17.5 9.7l-2.7 2.3 2.7 2.3 2.6-1.4c.8-.5.8-1.7 0-2.1zM4.6 20.9c.3 0 .6-.1.9-.3l10.6-6.1-2.5-2.5-9 8.9z"/></svg>
        Android — очаквайте скоро
      </span>
    </div>
  </section>

  <section id="player" class="band band-alt player-section">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">На живо</span>
        <h2>Слушай на живо</h2>
        <p>Истински български радио станции, директно в браузъра — без инсталация, без регистрация.</p>
      </div>
      <RadioPlayer />
    </div>
  </section>

  <section class="band spotlight" data-carousel aria-roledescription="carousel" aria-label="Станции на фокус">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Справочник</span>
        <h2>Станции на фокус</h2>
        <p>История, честоти и формат на най-известните български радиа.</p>
      </div>
      <div class="sl-track" data-carousel-track>
        {spotlight.map((st) => (
          <article class="sl-card">
            <div class="sl-cover" style={st.coverStyle}>
              <img src="/art/hero-waves-900.webp" alt="" width="900" height="563" loading="lazy" decoding="async" />
              {st.freq ? (
                <span class="sl-freq">{st.freq.num} <small>{st.freq.unit}</small><em>{st.freq.city}</em></span>
              ) : (
                <span class="sl-freq sl-freq-text">Онлайн</span>
              )}
              <button
                class="sl-play"
                type="button"
                data-play-station={st.playQuery}
                data-play-fallback={st.name}
                aria-label={`Пусни ${st.name}`}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>
              </button>
            </div>
            <h3><a href={`/stations/${st.slug}`}>{st.name}</a></h3>
            <p>{st.format}</p>
          </article>
        ))}
      </div>
      <div class="carousel-nav">
        <button class="sq-btn" type="button" data-carousel-prev aria-label="Предишни станции">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="sq-btn" type="button" data-carousel-next aria-label="Следващи станции">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
      <p class="center-link"><a class="link-arrow" href="/stations">Всички станции →</a></p>
    </div>
  </section>

  <section class="band band-deep about-strip">
    <div class="container about-grid">
      <figure class="about-art">
        <img src="/art/vinyl.svg" alt="Винилова плоча с логото на Радио България" width="1200" height="800" loading="lazy" decoding="async" />
      </figure>
      <div class="about-copy">
        <span class="section-kicker">За проекта</span>
        <h2>Кратко за нас</h2>
        <div class="prose">
          <p>
            Радио България е малък независим проект, чиято цел е да направи родното радио лесно достъпно
            — на всяко устройство, навсякъде по света. Приложението е направено от любители на българската
            музика и не е свързано с конкретна радиостанция или медийна група.
          </p>
          <p>
            Каталогът се захранва от <a href="https://www.radio-browser.info" target="_blank" rel="noopener noreferrer">Radio Browser</a>
            — отворена, общностно поддържана база данни. Самото съдържание (музика, новини, реклами)
            принадлежи на съответните радиа.
          </p>
        </div>
        <a class="cta" href="/about">Прочети повече</a>
        <p class="page-byline">
          Автор: <a href="/about">Екипът на Радио България</a>
          · Публикувано: <time datetime={DATE_PUBLISHED}>{fmtDate(DATE_PUBLISHED)}</time>
          · Обновено: <time datetime={DATE_MODIFIED}>{fmtDate(DATE_MODIFIED)}</time>
        </p>
      </div>
    </div>
  </section>

  <section id="features" class="band band-alt">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Възможности</span>
        <h2>Защо Радио България</h2>
        <p>Всичко необходимо, за да слушаш българско радио — без излишни функции.</p>
      </div>
      <div class="features features-six">
        {features.map((f) => <Feature title={f.title} description={f.description} icon={f.icon} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Android приложение</span>
        <h2>Така изглежда приложението</h2>
        <p>Просто, чисто и в твоя стил.</p>
      </div>
      <div class="screenshots">
        <img src="/screenshots/home.png" alt="Списък с български радио станции" loading="lazy" decoding="async" width="1080" height="2404" />
        <img src="/screenshots/favorites.png" alt="Любими станции" loading="lazy" decoding="async" width="1080" height="2404" />
        <img src="/screenshots/history.png" alt="История на слушане" loading="lazy" decoding="async" width="1080" height="2404" />
        <img src="/screenshots/player.png" alt="Ретро плейър със зелен скалател" loading="lazy" decoding="async" width="1080" height="2404" />
      </div>
    </div>
  </section>

  <section class="band band-alt">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Блог</span>
        <h2>От блога</h2>
        <p>Статии за българското радио, музика и полезни съвети.</p>
      </div>
      <div class="blog-grid blog-grid-home">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag-chip">{tag}</span>
                ))}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <time datetime={post.data.date}>{fmtDate(post.data.date)}</time>
            </div>
          </a>
        ))}
      </div>
      <p class="center-link"><a class="link-arrow" href="/blog">Всички статии →</a></p>
    </div>
  </section>

  <section id="faq" class="band">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Въпроси</span>
        <h2>Често задавани въпроси</h2>
        <p>Кратки отговори на най-честите въпроси за приложението.</p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <img class="cta-bg" src="/art/hero-waves-900.webp" alt="" width="900" height="563" loading="lazy" decoding="async" />
    <div class="container">
      <span class="section-kicker">На живо 24/7</span>
      <h2>Готов за слушане?</h2>
      <p>Пуснете любимата си станция директно в браузъра — безплатно и без регистрация.</p>
      <div class="hero-ctas">
        <a class="cta" href="#player">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>
          Слушай онлайн
        </a>
        <span class="cta cta-coming-soon">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5c0-.6.3-1.1.8-1.4L13.5 12 3.8 21.9c-.5-.3-.8-.8-.8-1.4zm10.6-8.5l2.5-2.5L5.5 3.4c-.3-.2-.6-.3-.9-.3l9 8.9zm6.5-3.7L17.5 9.7l-2.7 2.3 2.7 2.3 2.6-1.4c.8-.5.8-1.7 0-2.1zM4.6 20.9c.3 0 .6-.1.9-.3l10.6-6.1-2.5-2.5-9 8.9z"/></svg>
          Android — очаквайте скоро
        </span>
      </div>
    </div>
  </section>
</Base>
